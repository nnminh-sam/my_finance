# Node 20+; copy this file to the repository root .env (never commit secrets).
# Hosted/shell environment variables take precedence over .env (dotenv never overrides).
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require

# Exact frontend origin, no path, wildcard, or comma-separated list.
# Local default is http://localhost:5173. Production/Vercel MUST use HTTPS.
APP_ORIGIN=http://localhost:5173

# next dev / next start always use port 5173 (see package.json); PORT is not read by them.
NODE_ENV=development

# Optional: isolated Neon test database, pre-migrated with the same migration.
# Export this in your shell for npm test; tests do not load .env automatically.
# AUTH_TEST_DATABASE_URL=postgresql://USER:PASSWORD@TEST-NEON-HOST/DBNAME?sslmode=require
