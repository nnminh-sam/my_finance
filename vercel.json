{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "packages/client",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "cleanUrls": true,
      "rewrites": [
        { "source": "/login", "destination": "/login.html" },
        { "source": "/signup", "destination": "/signup.html" },
        { "source": "/calendar", "destination": "/calendar.html" },
        { "source": "/week", "destination": "/week.html" },
        { "source": "/day", "destination": "/day.html" },
        { "source": "/analytics", "destination": "/analytics.html" },
        { "source": "/profile", "destination": "/profile.html" }
      ]
    },
    "server": {
      "root": "packages/server",
      "framework": "express",
      "runtime": "node",
      "entrypoint": "src/app.ts",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "server" }
    },
    {
      "source": "/login",
      "destination": { "service": "client", "path": "/login.html" }
    },
    {
      "source": "/signup",
      "destination": { "service": "client", "path": "/signup.html" }
    },
    {
      "source": "/calendar",
      "destination": { "service": "client", "path": "/calendar.html" }
    },
    {
      "source": "/week",
      "destination": { "service": "client", "path": "/week.html" }
    },
    {
      "source": "/day",
      "destination": { "service": "client", "path": "/day.html" }
    },
    {
      "source": "/analytics",
      "destination": { "service": "client", "path": "/analytics.html" }
    },
    {
      "source": "/profile",
      "destination": { "service": "client", "path": "/profile.html" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "client" }
    }
  ]
}
